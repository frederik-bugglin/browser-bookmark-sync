# Junction — environment variables
# Copy this file to `.env.local` and fill in values from your Supabase project.
# Never commit `.env.local` (it is in .gitignore).

# Supabase project URL — find under: Project Settings → API → Project URL
SUPABASE_URL=

# Supabase anon (public) key — find under: Project Settings → API → anon public
# This key is safe to ship in the desktop app: RLS protects user data on the server.
SUPABASE_ANON_KEY=
